# 로컬 예시. 복사한 .env는 Git에 포함하지 않는다.
BONGHWA_ENVIRONMENT=local
BONGHWA_MODE=simulation
# DB / Redis 실행 후 연결할 때만 설정한다.
BONGHWA_DATABASE_URL=postgresql+psycopg://bonghwajigi:local-only@127.0.0.1:5432/bonghwajigi
BONGHWA_BROKER_URL=redis://127.0.0.1:6379/0
# 내부 GPU 인터페이스의 인증 토큰. 실제 값은 별도로 주입한다.
BONGHWA_SERVICE_TOKEN=
BONGHWA_GPU_BASE_URL=http://127.0.0.1:8001
BONGHWA_QWEN_MODEL=Qwen/Qwen3-4B-Instruct-2507
BONGHWA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
BONGHWA_GPU_MAX_TOTAL_TOKENS=4096
BONGHWA_GPU_MAX_OUTPUT_TOKENS=512
# 실제 GPU 서비스에서는 고정 리비전·토큰·캐시를 준비한 뒤 활성화한다.
BONGHWA_GPU_ENABLED=false
BONGHWA_QWEN_REVISION=
BONGHWA_EMBEDDING_REVISION=
# 수신→분석 큐→검색은 DB migration과 브로커·임베딩 인증을 준비한 뒤 활성화한다.
BONGHWA_ANALYSIS_ENABLED=false
BONGHWA_EMBEDDING_SERVICE_TOKEN=
BONGHWA_WEB_SEARCH_ENABLED=true
BONGHWA_WEB_SEARCH_MAX_RESULTS=5
BONGHWA_WEB_SEARCH_LOOKBACK_DAYS=7
BONGHWA_RETRIEVAL_TOP_K=5
BONGHWA_OUTBOX_REDELIVERY_SECONDS=180
# 정책 루프는 simulation 내부 API 전용이다. 레벨·운영 정책·알림은 회의 대기다.
BONGHWA_POLICY_ENABLED=false
BONGHWA_POLICY_QWEN_ENABLED=false
BONGHWA_POLICY_POLL_SECONDS=2
BONGHWA_POLICY_CHECK_SECONDS=30
BONGHWA_APP_ENABLED=false
# 내부 서비스 토큰과 다른 32바이트 이상 임의 키. 실제 값은 별도 비밀 설정에만 보관한다.
BONGHWA_JWT_SECRET=
BONGHWA_JWT_ISSUER=bonghwajigi-mvp
BONGHWA_JWT_AUDIENCE=bonghwajigi-app
BONGHWA_JWT_LIFETIME_SECONDS=86400
BONGHWA_NOTIFICATIONS_ENABLED=false
BONGHWA_PUSH_PROVIDER=disabled
BONGHWA_FCM_PROJECT_ID=
BONGHWA_FCM_CREDENTIALS_FILE=
# 개발용 Compose DB에만 사용. 원격 SSH 비밀번호와 무관하다.
POSTGRES_DB=bonghwajigi
POSTGRES_USER=bonghwajigi
POSTGRES_PASSWORD=local-only
